{
  "templates": [
    {
      "match": {
        "config": "mpl",
        "exp": "time"
      },
      "template": "/usr/bin/time -v bin/<bench>.<config>.bin @mpl <procs?procs {}> set-affinity -- <args?{} ><args1?{}> -repeat <repeat> -warmup <warmup>"
    }
  ],
