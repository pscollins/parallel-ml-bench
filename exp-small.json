      "mpl"
    ],
    "cwd": [
      "mpl"
    ],
    "exp": [
      "time"
    ],
    "trials": [
      "1"
    ]
  },
  "jqselect": "(  (.exp == \"time\")  or  (.exp == \"space\" and (.procs == \"1\" or .procs == $max_procs))  )",
