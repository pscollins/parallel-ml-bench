{
    "compiler": "~/code/mpl/build/bin/mpl",
    "flags": ["-codegen", "c",
              "-link-opt", "-s",
              "-build-magic", "0",
              "-shallow-flatten-max-iters", "0",
              "-pre-flatten-max-iters", "1",
              "-pre-flatten-consumer-policy", "all_unpack",
              "-pre-flatten-resolve-policy", "global",
              "-pre-flatten-recursive-steps", "10",
              "-pre-flatten-types-policy", "tuple",
              "-pre-flatten-phase", "late",
              "-pre-flatten-transfer-policy", "tail_only"
             ],
    "comment": "Tuple pre-flattening config",
    "compat": "mpl"
}
