  if not trials:
    return None, None
  r = trials[-1]
  return r.get('avgtime'), r.get('stddev')

RNG = np.random.default_rng(42)

def ratioStats(times_m, times_b, num_boot=10000, ci_level=0.95):
  if not times_m or not times_b:
    return None, None
  m = np.asarray(times_m, dtype=float)
  b = np.asarray(times_b, dtype=float)
  if len(m) == 0 or len(b) == 0:
    return None, None
  mean_b = np.mean(b)
  if mean_b == 0:
    return None, None
  ratio = float(np.mean(m) / mean_b)
  if len(m) <= 1 and len(b) <= 1:
    return ratio, 0.0
  boot_m = RNG.choice(m, size=(num_boot, len(m)), replace=True).mean(axis=1)
  boot_b = RNG.choice(b, size=(num_boot, len(b)), replace=True).mean(axis=1)
  valid = boot_b != 0
  if not np.any(valid):
    return ratio, 0.0
  boot_ratios = boot_m[valid] / boot_b[valid]
  alpha = (1.0 - ci_level) / 2.0 * 100.0
  ci_low, ci_high = np.percentile(boot_ratios, [alpha, 100.0 - alpha])
  ci = (ci_high - ci_low) / 2.0
  return ratio, float(ci)

def diffStats(times_m, times_b, num_boot=10000, ci_level=0.95):
  if not times_m or not times_b:
    return None, None
  m = np.asarray(times_m, dtype=float)
  b = np.asarray(times_b, dtype=float)
  if len(m) == 0 or len(b) == 0:
    return None, None
  diff = float(np.mean(m) - np.mean(b))
  if len(m) <= 1 and len(b) <= 1:
    return diff, 0.0
  boot_m = RNG.choice(m, size=(num_boot, len(m)), replace=True).mean(axis=1)
  boot_b = RNG.choice(b, size=(num_boot, len(b)), replace=True).mean(axis=1)
  boot_diffs = boot_m - boot_b
  alpha = (1.0 - ci_level) / 2.0 * 100.0
  ci_low, ci_high = np.percentile(boot_diffs, [alpha, 100.0 - alpha])
  ci = (ci_high - ci_low) / 2.0
  return diff, float(ci)

