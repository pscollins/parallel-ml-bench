def averageTime(data, config, tag, procs, checkExpType=True):
  trials = [ r for r in findTrials(data, config, tag, procs) if (not checkExpType) or (r['exp'] == 'time') ]
  tms = [ r['avgtime'] for r in trials if 'avgtime' in r ]
  try:
    return tms[-1]
  except:
    return None

def averageTimes(data, config, tag, procs, checkExpType=True):
  trials = [ r for r in findTrials(data, config, tag, procs) if (not checkExpType) or (r['exp'] == 'time') ]
  if not trials:
    return []
  return trials[-1].get('times', [])

def averageTimeWithStdDev(data, config, tag, procs, checkExpType=True):
  trials = [ r for r in findTrials(data, config, tag, procs) if (not checkExpType) or (r['exp'] == 'time') ]
  if not trials:
    return None, None
  r = trials[-1]
  return r.get('avgtime'), r.get('stddev')

def ratioStats(times_m, times_b):
  if not times_m or not times_b:
    return None, None
  n = min(len(times_m), len(times_b))
  if n == 0:
    return None, None
  ratios = [times_m[i] / times_b[i] for i in range(n)]
  return np.mean(ratios), (np.std(ratios) if n > 1 else 0.0)

def diffStats(times_m, times_b):
  if not times_m or not times_b:
    return None, None
  n = min(len(times_m), len(times_b))
  if n == 0:
    return None, None
  diffs = [times_m[i] - times_b[i] for i in range(n)]
  return np.mean(diffs), (np.std(diffs) if n > 1 else 0.0)

def averageSpace(data, config, tag, procs, checkExpType=True):
  trials = [ r for r in findTrials(data, config, tag, procs) if (not checkExpType) or r['exp'] == 'space' ]
  sp = [ r['space'] for r in trials if 'space' in r ]

  try:
    # sp = sp[-10:] if procs > 1 else sp[-1:]
    sp = sp[-1:]
    return sum(sp) / len(sp)
  except:
    return None

def averageSpaces(data, config, tag, procs, checkExpType=True):
  trials = [ r for r in findTrials(data, config, tag, procs) if (not checkExpType) or r['exp'] == 'space' ]
  return [ r['space'] for r in trials if 'space' in r ]

def approxRaceFactor(data, config, tag, procs):
