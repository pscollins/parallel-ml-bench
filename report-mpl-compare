def tm(t):
  if t is None:
    return None
  if t == 0.0:
    return int(0)
  # if t > 10.0:
  #   return int(round(t))
  try:
    if t < 1.0:
      return round(t, 3)
    if t < 10.0:
      return round(t, 2)
    elif t < 100.0:
      return round(t, 1)
    else:
      return round(t)
  except TypeError:
    print ("[ERR] Got type error trying to round {}".format(repr(t)))
    return None

def tm_std(t, s):
  if t is None:
    return "--"
  t_val = tm(t)
  if t_val is None: return "--"
  if s is not None:
    s_val = tm(s)
    if s_val is not None and s_val > 0:
      return "{} (\u00b1 {})".format(t_val, s_val)
  return str(t_val)

