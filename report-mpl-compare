    g = float(np.exp(np.mean(np.log(r_arr))))
    if len(r_arr) > 1:
      boot_indices = RNG.choice(len(r_arr), size=(10000, len(r_arr)), replace=True)
      boot_g = np.exp(np.mean(np.log(r_arr[boot_indices]), axis=1))
      ci_low, ci_high = np.percentile(boot_g, [2.5, 97.5])
      ci = float((ci_high - ci_low) / 2.0)
    else:
      ci = 0.0
    print("Geomean {}/{} (± ci): {} (± {})".format(FLAVOR_LETTER, BASELINE_LETTER, tm(g), tm(ci)))
