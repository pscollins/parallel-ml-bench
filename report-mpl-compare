headers += ['T(1)', None, None, None]
headers1 += ['B', 'M', 'M/B', 'M-B']

if has_parallel:
  headers += ['T({})'.format(maxp), None, None, None]
  headers1 += ['B', 'M', 'M/B', 'M-B']

if has_space:
  headers += ['R(1)', None, None, None]
  headers1 += ['B', 'M', 'M/B', 'M-B']
  if has_parallel:
    headers += ['R({})'.format(maxp), None, None, None]
    headers1 += ['B', 'M', 'M/B', 'M-B']

tt = [headers, "-", headers1, "="]

for res in all_results:
  tag = res['tag']
  bt1_avg, bt1_std = res['bt1']
  btp_avg, btp_std = res['btp']
  br1 = res['br1']
  brp = res['brp']
  mt1_avg, mt1_std = res['mt1']
  mtp_avg, mtp_std = res['mtp']
  mr1 = res['mr1']
  mrp = res['mrp']

  thisRow = [
    tm_std(bt1_avg, bt1_std),
    tm_std(mt1_avg, mt1_std),
    tm_std(*ratioStats(res['mt1_times'], res['bt1_times'])),
    tm_std(*diffStats(res['mt1_times'], res['bt1_times']))
  ]
  if has_parallel:
    thisRow += [
      tm_std(btp_avg, btp_std),
      tm_std(mtp_avg, mtp_std),
      tm_std(*ratioStats(res['mtp_times'], res['btp_times'])),
      tm_std(*diffStats(res['mtp_times'], res['btp_times']))
    ]
  if has_space:
    thisRow += [
      br1,
      mr1,
      tm_std(*ratioStats(res['mr1_spaces'], res['br1_spaces'])),
      tm_std(*[x/1000000.0 if x is not None else None for x in diffStats(res['mr1_spaces'], res['br1_spaces'])])
    ]
    if has_parallel:
      thisRow += [
        brp,
        mrp,
        tm_std(*ratioStats(res['mrp_spaces'], res['brp_spaces'])),
        tm_std(*[x/1000000.0 if x is not None else None for x in diffStats(res['mrp_spaces'], res['brp_spaces'])])
      ]
  thisRow = [displayTag(tag)] + [str(x) if x is not None else "--" for x in thisRow]
  tt.append(thisRow)

print("MPL vs MPL-BASELINE COMPARISON")
print(table(tt, defaultAlign))
print("")

